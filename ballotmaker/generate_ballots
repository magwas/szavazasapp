#!/usr/bin/env python3
import argparse
import random
import string
import subprocess
import sys
import os
import tempfile
import shutil

def generate_random_string(length=8):
    chars = string.ascii_uppercase + string.digits
    return ''.join(random.choice(chars) for _ in range(length))

def insert_overrides(template_content, titletext, numsupport, candidates):
    r"""Insert \renewcommand lines after the last \providecommand."""
    lines = template_content.splitlines()
    last_provide_idx = -1
    for i, line in enumerate(lines):
        if line.strip().startswith(r'\providecommand'):
            last_provide_idx = i
    if last_provide_idx == -1:
        for i, line in enumerate(lines):
            if line.strip().startswith(r'\ifcase\numsupport'):
                last_provide_idx = i - 1
                break
    overrides = [
        f"\\renewcommand{{\\titletext}}{{{titletext}}}",
        f"\\renewcommand{{\\numsupport}}{{{numsupport}}}",
        f"\\renewcommand{{\\candidates}}{{{candidates}}}",
        ""
    ]
    new_lines = lines[:last_provide_idx+1] + overrides + lines[last_provide_idx+1:]
    return '\n'.join(new_lines)

def get_preamble(modified_content):
    doc_begin = r'\begin{document}'
    pos = modified_content.rfind(doc_begin)
    if pos == -1:
        raise ValueError("No \\begin{document} in template")
    return modified_content[:pos]

def build_tex_content(preamble, ballots, voteid, numsupport, num_candidates):
    ids = [f"{voteid}-{numsupport}-{num_candidates}-{generate_random_string()}" for _ in range(ballots)]
    tex = preamble + "\n"
    tex += "\\begin{document}\n"
    for i, bid in enumerate(ids):
        tex += f"\\renewcommand{{\\id}}{{{bid}}}\n"
        tex += "\\ballotcontent\n"
        if i < len(ids) - 1:
            tex += "\\newpage\n"
    tex += "\\end{document}\n"
    return tex

def run_pdflatex(tex_path, output_dir):
    for _ in range(2):
        subprocess.run(
            ['pdflatex', '-interaction=nonstopmode',
             '-output-directory', output_dir, tex_path],
            capture_output=True, text=True
        )

def compile_pdf(tex_content, output_filename, keep_tempdir):
    tmpdir = tempfile.mkdtemp(prefix="ballot_compile_")
    print(f"Temporary directory: {tmpdir}", file=sys.stderr)
    try:
        tex_path = os.path.join(tmpdir, 'main.tex')
        with open(tex_path, 'w') as f:
            f.write(tex_content)
        run_pdflatex(tex_path, tmpdir)
        src_pdf = os.path.join(tmpdir, 'main.pdf')
        if not os.path.exists(src_pdf) or os.path.getsize(src_pdf) == 0:
            print("ERROR: PDF not generated or empty", file=sys.stderr)
            sys.exit(1)
        output_abs = os.path.abspath(output_filename)
        shutil.move(src_pdf, output_abs)
        print(f"Successfully created {output_abs}")
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        print(f"Temporary directory kept at: {tmpdir}", file=sys.stderr)
        sys.exit(1)
    else:
        if not keep_tempdir:
            shutil.rmtree(tmpdir, ignore_errors=True)
        else:
            print(f"Temporary directory kept at: {tmpdir}", file=sys.stderr)

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--ballots', type=int, required=True)
    parser.add_argument('--voteid', type=str, required=True)
    parser.add_argument('--candidates', type=str, required=True)
    parser.add_argument('--titletext', type=str, default='Sample Ballot')
    parser.add_argument('--numsupport', type=int, default=3)
    parser.add_argument('--template', type=str, default='ballot.tex')
    parser.add_argument('--output', type=str, default='ballots.pdf')
    parser.add_argument('--keep-tempdir', action='store_true')
    args = parser.parse_args()

    if not (0 <= args.numsupport <= 5):
        print("numsupport must be 0-5", file=sys.stderr)
        sys.exit(1)
    if not os.path.exists(args.template):
        print(f"Template '{args.template}' not found", file=sys.stderr)
        sys.exit(1)

    # Count the number of candidates (rows)
    candidates_list = [c.strip() for c in args.candidates.split(',')]
    num_candidates = len(candidates_list)

    with open(args.template, 'r') as f:
        template_content = f.read()

    modified = insert_overrides(template_content, args.titletext,
                                str(args.numsupport), args.candidates)
    preamble = get_preamble(modified)
    tex_content = build_tex_content(preamble, args.ballots, args.voteid,
                                    args.numsupport, num_candidates)
    compile_pdf(tex_content, args.output, args.keep_tempdir)

if __name__ == '__main__':
    main()
